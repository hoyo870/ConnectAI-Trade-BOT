# ── 텔레그램 알림 ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── 레버리지 ──────────────────────────────────────────────────────────────────
LEVERAGE=5

# ── Antifragile 파라미터 프리셋 ──────────────────────────────────────────────
# prod(기본) | stable | aggressive | conservative
#   prod:         DEFAULT_PARAMS 그대로
#   stable:       보수적 진입 + 타이트한 trail
#   aggressive:   넓은 진입 + 빠른 trail
#   conservative: 엄격한 진입 + 넓은 trail
AF_PARAM_PRESET=prod

# ── ML 진입 필터 ───────────────────────────────────────────────────────────────
# AFEnsemble(LGBM+LSTM) 항상 필수 — 모델 없으면 봇 시작 불가
# models/af_ensemble/saved/ 에 학습된 모델 필요
ML_MODEL_DIR=models/af_ensemble/saved

# ── 전략 / 거래소 ─────────────────────────────────────────────────────────────
STRATEGY=antifragile   # 고정 (유일한 전략)
EXCHANGE=bybit         # bybit | bingx

# ── 거래 모드 ─────────────────────────────────────────────────────────────────
# real | sandbox | paper
#   real    : 실계좌 주문 실행
#   sandbox : 테스트넷 (Bybit만 지원)
#   paper   : 실시세 조회 + 가상 주문 (주문 없음)
TRADE_MODE=paper

# paper 모드 전용: 가상 시드 자본 (USDT)
PAPER_SEED=10000

# 실계좌 모드 전용: 거래소 잔고 조회 실패 시 fallback 자본 (USDT)
BOT_SEED=1000

# ── Bybit API ─────────────────────────────────────────────────────────────────
# 테스트넷 (TRADE_MODE=sandbox 시 사용)
BYBIT_SANDBOX_API_KEY=your_bybit_sandbox_api_key_here
BYBIT_SANDBOX_API_SECRET=your_bybit_sandbox_api_secret_here

# 실계좌 (TRADE_MODE=real 시 사용, 주의!)
BYBIT_REAL_API_KEY=your_bybit_real_api_key_here
BYBIT_REAL_API_SECRET=your_bybit_real_api_secret_here

# ── BingX API ─────────────────────────────────────────────────────────────────
# BingX는 sandbox 미지원 → TRADE_MODE=sandbox 시 paper로 자동 전환
BINGX_REAL_API_KEY=your_bingx_real_api_key_here
BINGX_REAL_API_SECRET=your_bingx_real_api_secret_here
