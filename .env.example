# ── 텔레그램 알림 ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── 전략 선택 ─────────────────────────────────────────────────────────────────
# STRATEGY 옵션: antifragile(기본 권장) | dl_v17
#   antifragile : AdaptRSI + ATR trailing stop, BTC/ETH/SOL/XRP 4종 자동 실행
#   dl_v17      : TCN+Attention DL 모델, 단일 코인 (COIN 환경변수 필요)
STRATEGY=antifragile

# dl_v17 전용: 거래할 단일 코인 (STRATEGY=dl_v17 시만 사용)
# COIN=BTC

# ── 거래소 선택 ───────────────────────────────────────────────────────────────
# EXCHANGE 옵션: bybit(기본) | bingx
EXCHANGE=bybit

# ── 거래 모드 ─────────────────────────────────────────────────────────────────
# TRADE_MODE 옵션: real | sandbox | paper
#   real    : 실계좌 주문 실행
#   sandbox : 테스트넷 (Bybit만 지원 / BingX는 자동으로 paper 처리)
#   paper   : 실시세 조회 + 가상 주문 시뮬레이션 (주문 없음)
TRADE_MODE=paper

# paper 모드 전용: 가상 시드 자본 (USDT)
PAPER_SEED=10000

# ── Bybit API ─────────────────────────────────────────────────────────────────
# 테스트넷 API 키 (EXCHANGE=bybit, TRADE_MODE=sandbox 시 사용)
BYBIT_SANDBOX_API_KEY=your_bybit_sandbox_api_key_here
BYBIT_SANDBOX_API_SECRET=your_bybit_sandbox_api_secret_here

# 실계좌 API 키 (EXCHANGE=bybit, TRADE_MODE=real 시 사용, 주의!)
BYBIT_REAL_API_KEY=your_bybit_real_api_key_here
BYBIT_REAL_API_SECRET=your_bybit_real_api_secret_here

# ── BingX API ─────────────────────────────────────────────────────────────────
# BingX는 sandbox 미지원 → TRADE_MODE=sandbox 설정 시 paper로 자동 전환
# 실계좌 API 키 (EXCHANGE=bingx, TRADE_MODE=real 시 사용, 주의!)
BINGX_REAL_API_KEY=your_bingx_real_api_key_here
BINGX_REAL_API_SECRET=your_bingx_real_api_secret_here
