# ── 텔레그램 알림 ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Bybit ─────────────────────────────────────────────────────────────────────
# TRADE_MODE 옵션: real | sandbox | paper
#   real    : 실계좌 주문 실행
#   sandbox : 테스트넷 주문 실행
#   paper   : 실시세 조회 + 가상 주문 시뮬레이션 (주문 없음)
TRADE_MODE=paper

# paper 모드 전용: 가상 시드 자본 (USDT)
PAPER_SEED=10000

# 테스트넷 API 키 (TRADE_MODE=sandbox 시 사용)
BYBIT_SANDBOX_API_KEY=your_sandbox_api_key_here
BYBIT_SANDBOX_API_SECRET=your_sandbox_api_secret_here

# 실계좌 API 키 (TRADE_MODE=real 시 사용, 주의!)
BYBIT_REAL_API_KEY=your_real_api_key_here
BYBIT_REAL_API_SECRET=your_real_api_secret_here
