# ── 텔레그램 알림 ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── 레버리지 ──────────────────────────────────────────────────────────────────
# Antifragile 전략 레버리지 (1~10 권장)
LEVERAGE=5

# ── Antifragile 파라미터 프리셋 ──────────────────────────────────────────────
# AF_PARAM_PRESET 옵션: stable | aggressive | (비워두면 기본값 사용)
#   stable:     RSI R1(25/65,30/70,38/75) + SL(1.0/1.2) + 피라미딩4 — TPD≈8.6,  MDD≈3.3%
#   aggressive: RSI R2(28/62,32/68,40/72) + SL(1.0/1.2) + 피라미딩4 — TPD≈13.2, MDD≈4.1%
#   (미설정)  : 코드 내 AF_PARAMS 기본값 사용
AF_PARAM_PRESET=stable

# ── 전략 선택 ─────────────────────────────────────────────────────────────────
STRATEGY=antifragile

# ── 거래소 선택 ───────────────────────────────────────────────────────────────
# EXCHANGE 옵션: bybit(기본) | bingx
EXCHANGE=bybit

# ── 거래 모드 ─────────────────────────────────────────────────────────────────
# TRADE_MODE 옵션: real | sandbox | paper
TRADE_MODE=paper

# paper 모드 전용: 가상 시드 자본 (USDT)
PAPER_SEED=10000

# 실계좌 모드 전용: 진입 시드 자본 (USDT, 거래소 잔고 조회 실패 시 fallback)
BOT_SEED=1000

# ── Bybit API ─────────────────────────────────────────────────────────────────
BYBIT_SANDBOX_API_KEY=your_bybit_sandbox_api_key_here
BYBIT_SANDBOX_API_SECRET=your_bybit_sandbox_api_secret_here

BYBIT_REAL_API_KEY=your_bybit_real_api_key_here
BYBIT_REAL_API_SECRET=your_bybit_real_api_secret_here

# ── BingX API ─────────────────────────────────────────────────────────────────
BINGX_REAL_API_KEY=your_bingx_real_api_key_here
BINGX_REAL_API_SECRET=your_bingx_real_api_secret_here
